#version 450
// GLSL twin of scalar.wgsl (control).
// expect: 4 4
struct S {
    vec3 v;  // offset 0
    float a; // offset 12
};

layout(set = 0, binding = 0, std140) uniform U { S s; } u;
layout(set = 0, binding = 1, std430) buffer Out { float o[16]; } result;

float get_a(float a) {
    return a;
}

layout(local_size_x = 1) in;
void main() {
    result.o[0] = get_a(u.s.a);
    result.o[1] = u.s.a;
}
